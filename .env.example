# Eda 0.6.0
FLASK_ENV=production
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
APP_NAME=Eda
APP_URL=https://finance.freshcrackers.cz

# MariaDB/MySQL (recommended)
# Example: mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE?charset=utf8mb4

# Session / reverse proxy
SESSION_COOKIE_SECURE=1
TRUST_PROXY=1

# Fresh Core inbound connector
FRESH_CORE_SHARED_SECRET=CHANGE_ME

# ABRA Flexi
FLEXIBEE_BASE_URL=https://demo.flexibee.eu
FLEXIBEE_COMPANY=demo
FLEXIBEE_USERNAME=
FLEXIBEE_PASSWORD=
FLEXIBEE_VERIFY_SSL=1
FLEXIBEE_INVOICE_TYPE_CODE=FAKTURA
FLEXIBEE_DEFAULT_DUE_DAYS=14

# Optional Fresh Crackers SSO button
FRESH_CRACKERS_SSO_URL=

# Fresh AI Engine / Eda Chat / Fresh Key Propojení
# AI_ENGINE_API_KEY musí být app-specific klíč Edy; používá se i pro projektové Propojení a SSO.
AI_ENGINE_URL=https://aiengine.freshcrackers.cz
AI_ENGINE_API_KEY=
AI_ENGINE_APP_ID=eda

# Document inbox
MAX_CONTENT_LENGTH_MB=20

# Volitelné: oddělené ABRA Flexi připojení pro každou firmu v Edovi.
# ID firmy zjistíš v Admin konzoli. Pokud tyto proměnné nejsou nastavené,
# Eda použije výše uvedené globální FLEXIBEE_* hodnoty (zpětná kompatibilita).
# FLEXIBEE_ORG_1_BASE_URL=https://firma.flexibee.eu
# FLEXIBEE_ORG_1_COMPANY=firma_s_r_o
# FLEXIBEE_ORG_1_USERNAME=api_user
# FLEXIBEE_ORG_1_PASSWORD=CHANGE_ME
# FLEXIBEE_ORG_1_VERIFY_SSL=1

# Volitelné pro vzdálený přístup k diagnostickému manifestu mimo přihlášenou admin session
DIAGNOSTIC_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Eda Chat / Fresh AI Engine
AI_ENGINE_QUALITY=balanced
AI_ENGINE_MAX_COST_USD=0.20
AI_ENGINE_TIMEOUT_SECONDS=90
# Celkový objem příloh, který Eda přibalí do jednoho Engine requestu jako base64.
# Větší soubory Eda uloží, ale do Engine pošle pouze metadata.
AI_ENGINE_ATTACHMENT_MAX_MB=8
AI_ENGINE_ATTACHMENT_TEXT_MAX_CHARS=60000
