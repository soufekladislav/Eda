# Fresh AI Engine / Eda Chat
AI_ENGINE_URL=https://aiengine.freshcrackers.cz
AI_ENGINE_API_KEY=fae_lFYh6dvx3QAlioZNW6rmThC9wk3QjF_S9E4Qgh8YPC0
