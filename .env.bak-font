# MariaDB/MySQL (recommended)
# Example: mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://lauhannq_fcsadmin:y5brvwr3xfp0g2cw@localhost:3306/lauhannq_eda-finance?charset=utf8mb4

# Session / reverse proxy
SESSION_COOKIE_SECURE=1
TRUST_PROXY=1

# Fresh Core inbound connector
FRESH_CORE_SHARED_SECRET=CHANGE_ME

# ABRA Flexi
FLEXIBEE_BASE_URL=https://demo.flexibee.eu
FLEXIBEE_COMPANY=demo
FLEXIBEE_USERNAME=
FLEXIBEE_PASSWORD=
